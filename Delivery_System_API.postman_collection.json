            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"EXPIRED\",\n  \"order_amount\": 500\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/promo-codes/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "promo-codes", "validate"]
            },
