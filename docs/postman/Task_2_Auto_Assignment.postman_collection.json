        {
          "name": "Auto-Assign Order 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('Courier assigned', () => pm.expect(pm.response.json().assigned_courier).to.exist);",
                  "pm.test('Closest selected', () => {",
                  "  const name = pm.response.json().assigned_courier.courier.name;",
                  "  pm.expect(name).to.equal('Иван Близкий');",
                  "  console.log('Selected:', name);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order1_id}}/auto-assign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order1_id}}",
                "auto-assign"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Order 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Has courier_id', () => pm.expect(pm.response.json().courier_id).to.exist);",
                  "pm.test('Status accepted', () => pm.expect(pm.response.json().status).to.equal('accepted'));"
                ],
                "type": "text/javascript"
