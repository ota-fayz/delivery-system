            "body": {
              "mode": "raw",
              "raw": "{\"customer_name\": \"\\u041a\\u043b\\u0438\\u0435\\u043d\\u0442 1\", \"customer_phone\": \"+79991111111\", \"delivery_address\": \"\\u041c\\u043e\\u0441\\u043a\\u0432\\u0430, \\u0443\\u043b. \\u0422\\u0435\\u0441\\u0442\\u043e\\u0432\\u0430\\u044f, 1\", \"items\": [{\"name\": \"\\u041f\\u0438\\u0446\\u0446\\u0430\", \"quantity\": 1, \"price\": 500}]}"
