          "name": "Получить данные курьера (проверка рейтинга)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Курьер получен успешно', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Рейтинг курьера обновлён', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.rating).to.exist;",
                  "    pm.expect(response.rating).to.be.a('number');",
                  "    pm.expect(response.rating).to.be.at.least(1);",
                  "    pm.expect(response.rating).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test('Количество отзывов корректно', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.total_reviews).to.be.a('number');",
                  "    pm.expect(response.total_reviews).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Рейтинг 4.5 после двух отзывов (5 и 4)', function () {",
                  "    const response = pm.response.json();",
                  "    if (response.total_reviews === 2) {",
                  "        pm.expect(response.rating).to.equal(4.5);",
                  "    }",
                  "});",
                  "",
                  "console.log('Рейтинг курьера:', pm.response.json().rating);",
                  "console.log('Всего отзывов:', pm.response.json().total_reviews);"
                ],
