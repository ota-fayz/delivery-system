      "name": "3. Получение отзывов",
      "item": [
        {
          "name": "Получить отзывы курьера",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Отзывы получены успешно', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Список содержит отзывы', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "    pm.expect(response.length).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Отзывы отсортированы по дате', function () {",
                  "    const response = pm.response.json();",
                  "    if (response.length > 1) {",
                  "        const first = new Date(response[0].created_at);",
                  "        const second = new Date(response[1].created_at);",
                  "        pm.expect(first).to.be.at.least(second);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/couriers/{{courier_id}}/reviews",
