    {
      "name": "5. Фильтрация по рейтингу",
      "item": [
        {
          "name": "Получить доступных курьеров (без фильтра)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Запрос выполнен успешно', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Возвращён массив курьеров', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Курьеры отсортированы по рейтингу', function () {",
                  "    const response = pm.response.json();",
                  "    if (response.length > 1) {",
                  "        // Проверяем, что курьеры с рейтингом идут перед курьерами без рейтинга",
                  "        for (let i = 0; i < response.length - 1; i++) {",
                  "            if (response[i].rating !== null && response[i+1].rating !== null) {",
                  "                pm.expect(response[i].rating).to.be.at.least(response[i+1].rating);",
                  "            }",
                  "        }",
                  "    }",
                  "});",
                  "",
                  "console.log('Доступные курьеры:', pm.response.json().map(c => ({",
                  "    id: c.id,",
                  "    name: c.name,",
                  "    rating: c.rating,",
                  "    total_reviews: c.total_reviews",
                  "})));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
