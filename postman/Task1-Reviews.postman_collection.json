      "name": "1. Подготовка данных",
      "item": [
        {
          "name": "Создать курьера",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Сохраняем courier_id в переменные окружения",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('courier_id', response.id);",
                  "    pm.test('Курьер создан успешно', function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "    pm.test('Ответ содержит ID курьера', function () {",
                  "        pm.expect(response.id).to.be.a('string');",
                  "    });",
                  "    pm.test('Рейтинг пустой у нового курьера', function () {",
                  "        pm.expect(response.rating).to.be.null;",
                  "        pm.expect(response.total_reviews).to.equal(0);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Иван Петров\",\n  \"phone\": \"+79991234567\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/couriers",
              "host": ["{{base_url}}"],
              "path": ["api", "couriers"]
            }
